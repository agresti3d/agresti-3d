rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function esAdmin() {
      return request.auth != null
        && request.auth.token.email == 'agresti.3d@gmail.com';
    }

    // El sitio público lee solamente la versión publicada.
    match /catalogo/publicado {
      allow read: if true;
      allow write: if esAdmin();
    }

    // El borrador es privado del administrador.
    match /catalogo/borrador {
      allow read, write: if esAdmin();
    }

    // Reseñas enviadas por clientes: se crean sin cuenta y quedan pendientes.
    // Solo el administrador puede leerlas, aprobarlas o borrarlas.
    function resenaValida() {
      return request.resource.data.productoId is string
        && request.resource.data.productoId.size() > 0
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 80
        && request.resource.data.texto is string
        && request.resource.data.texto.size() > 0
        && request.resource.data.texto.size() <= 600
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.foto is string
        && request.resource.data.foto.size() <= 500;
    }

    // Pedidos: se crean desde el carrito sin cuenta. Se puede leer un pedido
    // puntual con su código, pero no listar todos; el admin sí puede listar
    // y actualizar estados.
    match /pedidos/{codigo} {
      allow get: if true;
      allow list: if esAdmin();
      allow create: if request.resource.data.codigo == codigo
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.total is int
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 100;
      allow update, delete: if esAdmin();
    }

    // Analítica anónima: nadie puede leerla desde la web, solo el administrador.
    match /eventos/{evento} {
      allow create: if request.resource.data.evento is string
        && request.resource.data.evento.size() > 0
        && request.resource.data.evento.size() <= 60;
      allow read: if esAdmin();
    }

    // Avisos de reposición: se crean sin cuenta y los lee el administrador.
    match /avisosStock/{aviso} {
      allow create: if request.resource.data.productoId is string
        && request.resource.data.productoId.size() > 0
        && request.resource.data.contacto is string
        && request.resource.data.contacto.size() > 0
        && request.resource.data.contacto.size() <= 120
        && request.resource.data.estado == 'pendiente';
      allow read: if esAdmin();
    }

    match /resenas/{resena} {
      allow create: if resenaValida();
      allow read, update, delete: if esAdmin();
    }

    // Configuración privada (token de GitHub para disparar el SEO).
    // Solo el administrador puede leerla; se escribe desde la consola.
    match /config/{documento} {
      allow read: if esAdmin();
      allow write: if false;
    }
  }
}
